[Desktop Entry]
Name=Deskstamp
GenericName=Desktop Watermark
Comment=Display lightweight custom watermarks directly on your desktop
Exec=deskstamp gui
Icon=io.github.gabrielbaiano.Deskstamp
Terminal=false
Type=Application
Categories=Utility;
Keywords=watermark;desktop;screen;record;stream;cosmic;wayland;
StartupNotify=true
Actions=Toggle;Reload;Daemon;

[Desktop Action Toggle]
Name=Toggle Watermark
Exec=deskstamp toggle

[Desktop Action Reload]
Name=Reload Configuration
Exec=deskstamp reload

[Desktop Action Daemon]
Name=Start Background Daemon
Exec=deskstamp daemon
